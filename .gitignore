# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js & Build Outputs
.next/
out/
build/
dist/

# ==============================================================================
# SECRETS & ENVIRONMENT VARIABLES (NEVER COMMIT)
# ==============================================================================
.env
.env.*
*.env
*.env.*
**/.env
**/.env.*
!**/.env.example

# Private Keys, Certificates & Tokens
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx
*.pkcs12
*.jks
*.keystore
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Service Account Credentials & Auth JSONs
*service-account*.json
*credentials*.json
*secret*.json
google-services.json
GoogleService-Info.plist

# Logs & Diagnostic Outputs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/
*.log

# Runtime Local Persistent Data
server/data/*.json
server/data/*.tmp
!server/data/.gitkeep

# OS & Editor Metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# TypeScript & Runtime Caches
*.tsbuildinfo
next-env.d.ts
.turbo/
